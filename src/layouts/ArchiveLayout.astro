---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import VideoModal from '../components/VideoModal.astro';

interface Props {
  title: string;
  description?: string;
  intro?: string;
}
const { title, description = 'مسکن‌تاک', intro } = Astro.props;
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0A0B10">
<title>{title} | مسکن‌تاک</title>
<meta name="description" content={description}>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23F5A623'/><text x='50' y='72' font-size='62' text-anchor='middle' font-family='sans-serif' font-weight='bold' fill='%231A1A1A'>م</text></svg>">
</head>
<body>
<Header />
<main id="top">
  <section class="archive-hero">
    <div class="container">
      <h1 class="archive-title">{title}</h1>
      {intro && <p class="archive-intro">{intro}</p>}
    </div>
  </section>
  <section class="archive-wrap">
    <div class="container">
      <slot />
    </div>
  </section>
</main>
<Footer />
<BottomNav />
<VideoModal />

<script is:inline>
(function(){
  // Reveal observer — fixes blank footer newsletter on archive pages
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) {
          en.target.classList.add('visible');
          obs.unobserve(en.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(function(el){ obs.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('visible'); });
  }
})();
</script>
</body>
</html>