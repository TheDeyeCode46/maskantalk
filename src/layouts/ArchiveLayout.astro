---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  intro?: string;
}
const { title, description = 'مسکن‌تاک', intro } = Astro.props;
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#FBF9F4">
<title>{title} | مسکن‌تاک</title>
<meta name="description" content={description}>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23F5A623'/><text x='50' y='72' font-size='62' text-anchor='middle' font-family='sans-serif' font-weight='bold' fill='%231A1A1A'>م</text></svg>">
</head>
<body class="archive-body">
<Header />
<main id="top">
  <div class="archive-hero">
    <div class="container">
      <h1 class="archive-title">{title}</h1>
      {intro && <p class="archive-intro">{intro}</p>}
    </div>
  </div>
  <div class="archive-wrap">
    <slot />
  </div>
</main>
<Footer />
<BottomNav />
</body>
</html>

<style is:global>
/* Light theme overrides when body has .archive-body */
.archive-body {
  background: #FBF9F4 !important;
  color: #1A1A1A !important;
}
.archive-body .site-header {
  background: rgba(251,249,244,.9) !important;
  border-bottom-color: rgba(0,0,0,.08) !important;
}
.archive-body .brand-text,
.archive-body .nav a,
.archive-body .bn-item { color: #1A1A1A !important; }
.archive-body .nav a { color: #4A4A4A !important; }
.archive-body .bn-item { color: #9A9A9A !important; }
.archive-body .bn-item.active { color: #F5A623 !important; }
.archive-body .brand-mark { color: #1A1A1A !important; }
.archive-body .header-contact-mobile { color: #8A5A0A !important; }
.archive-body .socials-top a svg { fill: #4A4A4A !important; }

.archive-hero {
  background: #FBF9F4;
  padding: 3rem 0 2rem;
  border-bottom: 1px solid rgba(0,0,0,.06);
}
.archive-title {
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  font-weight: 900;
  letter-spacing: -.03em;
  color: #1A1A1A;
  margin-bottom: .5rem;
}
.archive-intro {
  color: #5A5A5A;
  font-size: .95rem;
  line-height: 1.8;
  max-width: 640px;
}
.archive-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2.5rem 1.25rem 5rem;
}

/* Cards in archive context */
.archive-body .bento-card { border: 1px solid rgba(0,0,0,.08) !important; }
.archive-body .news-card {
  background: #FFFFFF !important;
  border-color: rgba(0,0,0,.08) !important;
}
.archive-body .news-card:hover { border-color: rgba(245,166,35,.4) !important; }
.archive-body .news-card-body h4 { color: #1A1A1A !important; }
.archive-body .news-card-date { color: #9A9A9A !important; }
.archive-body .empty-state {
  background: #FFFFFF !important;
  color: #5A5A5A !important;
  border-color: rgba(0,0,0,.08) !important;
}

/* Pagination */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: .5rem;
  margin-top: 3rem;
  flex-wrap: wrap;
}
.pagination a, .pagination span {
  min-width: 42px;
  height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-weight: 700;
  font-size: .9rem;
  border: 1px solid rgba(0,0,0,.1);
  background: #FFF;
  color: #1A1A1A;
  transition: all .2s;
  padding: 0 .75rem;
}
.pagination a:hover { border-color: #F5A623; color: #F5A623; }
.pagination .current {
  background: #F5A623;
  color: #1A1A1A;
  border-color: #F5A623;
}
.pagination .disabled {
  opacity: .35;
  pointer-events: none;
}

/* Grids */
.archive-grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
@media (max-width: 900px) {
  .archive-grid-3 { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
}
@media (max-width: 600px) {
  .archive-grid-3 { grid-template-columns: 1fr; }
}

.archive-card {
  background: #FFF;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all .3s;
  color: #1A1A1A;
  height: 100%;
}
.archive-card:hover {
  border-color: rgba(245,166,35,.4);
  transform: translateY(-4px);
  box-shadow: 0 18px 40px -20px rgba(0,0,0,.15);
}
.archive-card .ac-thumb {
  position: relative;
  aspect-ratio: 16/9;
  background: #EDE9DE;
  overflow: hidden;
}
.archive-card .ac-thumb img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .5s;
}
.archive-card:hover .ac-thumb img { transform: scale(1.05); }
.archive-card .ac-body { padding: 1rem 1.1rem 1.2rem; flex: 1; display: flex; flex-direction: column; }
.archive-card .ac-cat {
  display: inline-block;
  color: #B8700A;
  font-size: .68rem;
  font-weight: 800;
  letter-spacing: .1em;
  margin-bottom: .4rem;
}
.archive-card .ac-title {
  font-size: 1rem;
  font-weight: 800;
  line-height: 1.5;
  color: #1A1A1A;
  margin-bottom: .5rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.archive-card .ac-desc {
  font-size: .82rem;
  color: #5A5A5A;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: .75rem;
  flex: 1;
}
.archive-card .ac-meta {
  font-size: .72rem;
  color: #9A9A9A;
  display: flex;
  gap: .5rem;
  padding-top: .6rem;
  border-top: 1px solid rgba(0,0,0,.05);
}

/* Reels grid (portrait) */
.reels-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}
@media (max-width: 1024px) { .reels-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 700px) { .reels-grid { grid-template-columns: repeat(2, 1fr); gap: .75rem; } }

.reel-archive-card {
  position: relative;
  aspect-ratio: 9/16;
  border-radius: 16px;
  overflow: hidden;
  background: #EDE9DE;
  color: #FFF;
  display: block;
  transition: transform .3s;
  border: 1px solid rgba(0,0,0,.08);
}
.reel-archive-card:hover { transform: translateY(-4px); }
.reel-archive-card img {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  transition: transform .5s;
}
.reel-archive-card:hover img { transform: scale(1.06); }
.reel-archive-card::after {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(0,0,0,.85) 100%);
}
.reel-archive-card .body {
  position: absolute; bottom: 0; right: 0; left: 0;
  padding: 1rem .9rem; z-index: 2;
}
.reel-archive-card .body h4 {
  font-size: .85rem; font-weight: 700; line-height: 1.5;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden; margin-bottom: .2rem;
}
.reel-archive-card .body span { font-size: .68rem; color: rgba(255,255,255,.7); }
</style>