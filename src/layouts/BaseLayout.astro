---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';
import VideoModal from '../components/VideoModal.astro';
import Preloader from '../components/Preloader.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'مسکن‌تاک — گفتگوهای تخصصی بازار مسکن',
  image
} = Astro.props;

const path = Astro.url.pathname;
const isHome = path === '/' || path === '';

const siteUrl = 'https://maskantalk.ir';
const fullUrl = `${siteUrl}${path}`;
const fullImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/og-cover.jpg`;
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0A0B10">

<title>{title} | مسکن‌تاک</title>
<meta name="description" content={description}>

<link rel="canonical" href={fullUrl}>

<!-- Open Graph (Telegram, WhatsApp, Facebook, LinkedIn preview) -->
<meta property="og:type" content="website">
<meta property="og:locale" content="fa_IR">
<meta property="og:site_name" content="مسکن‌تاک">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={fullUrl}>
<meta property="og:image" content={fullImage}>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={fullImage}>

<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23F5A623'/><text x='50' y='72' font-size='62' text-anchor='middle' font-family='sans-serif' font-weight='bold' fill='%231A1A1A'>م</text></svg>">

<!-- Organization schema (Google brand identity) -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsMediaOrganization",
  name: "مسکن‌تاک",
  alternateName: "Maskan Talk",
  url: siteUrl,
  logo: `${siteUrl}/og-cover.jpg`,
  sameAs: [
    "https://www.aparat.com/Maskantalk",
    "https://www.youtube.com/@Maskan.news24",
    "https://www.instagram.com/maskantalk",
    "https://ble.ir/maskannews24"
  ]
})}></script>

<script is:inline>
  try {
    if (sessionStorage.getItem('maskantalk-preloader-shown') === '1') {
      document.documentElement.classList.add('preloader-skip');
    }
  } catch (e) {}
</script>
</head>
<body>
{isHome && <Preloader />}
<Header />
<main id="top">
  <slot />
</main>
<Footer />
<BottomNav />
<VideoModal />

<script is:inline>
(function(){
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) {
          en.target.classList.add('visible');
          obs.unobserve(en.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(function(el){ obs.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('visible'); });
  }
})();
</script>
</body>
</html>
