---
interface Props {
  hash: string;
  title?: string;
}
const { hash, title = 'ویدیو مسکن‌تاک' } = Astro.props;
---
<div class="aparat-wrap">
  <iframe
    src={`https://www.aparat.com/video/video/embed/videohash/${hash}/vt/frame`}
    title={title}
    allowfullscreen
    webkitallowfullscreen
    mozallowfullscreen
  ></iframe>
</div>

<style>
  .aparat-wrap {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin: 2rem 0;
    border-radius: 16px;
    background: #050508;
  }
  .aparat-wrap iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: 0;
  }
</style>