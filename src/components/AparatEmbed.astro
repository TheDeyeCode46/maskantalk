---
interface Props {
  hash: string;
  title?: string;
  aspect?: '16:9' | '9:16';
}
const { hash, title = 'ویدیو مسکن‌تاک', aspect = '16:9' } = Astro.props;
const padding = aspect === '9:16' ? '177.78%' : '56.25%';
---
<div class="aparat-wrap" style={`--padding:${padding}`}>
  <iframe
    src={`https://www.aparat.com/video/video/embed/videohash/${hash}/vt/frame`}
    title={title}
    allowfullscreen
    webkitallowfullscreen
    mozallowfullscreen
  ></iframe>
</div>

<style>
  .aparat-wrap {
    position: relative;
    padding-bottom: var(--padding);
    height: 0;
    overflow: hidden;
    margin: 1.5rem 0;
    border-radius: 16px;
    background: #050508;
  }
  .aparat-wrap iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: 0;
  }
</style>