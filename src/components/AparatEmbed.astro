---
import { buildAparatEmbedUrl } from '../lib/aparat';

interface Props {
  hash: string;
  title?: string;
  aspect?: '16:9' | '9:16';
  autoplay?: boolean;
}
const {
  hash: rawHash,
  title = 'ویدیو مسکن‌تاک',
  aspect = '16:9',
  autoplay = false,
} = Astro.props;

const embedUrl = buildAparatEmbedUrl(rawHash, { autoplay });
const aspectClass = aspect === '9:16' ? 'vertical' : 'horizontal';
---
{embedUrl ? (
  <div class={`aparat-wrap aspect-${aspectClass}`}>
    <iframe
      src={embedUrl}
      title={title}
      allow="autoplay; fullscreen; encrypted-media; picture-in-picture; clipboard-write"
      allowfullscreen
      webkitallowfullscreen
      mozallowfullscreen
      referrerpolicy="strict-origin-when-cross-origin"
      scrolling="no"
      frameborder="0"
    ></iframe>
  </div>
) : (
  <div class="aparat-error">
    <p>کد ویدیو آپارات نامعتبر است.</p>
    <a href={`https://www.aparat.com/v/${rawHash}`} target="_blank" rel="noopener">
      تلاش برای باز کردن در آپارات ↗
    </a>
  </div>
)}

<style>
  .aparat-wrap {
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
    border-radius: 16px;
    background: #050508;
    margin: 1.5rem 0;
  }
  .aparat-wrap.aspect-horizontal { padding-bottom: 56.25%; }
  .aparat-wrap.aspect-vertical { padding-bottom: 177.78%; }

  .aparat-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .aparat-error {
    padding: 2rem;
    text-align: center;
    background: #1a1a22;
    border: 1px dashed rgba(255,255,255,.2);
    border-radius: 16px;
    color: #aaa;
    font-size: .9rem;
    margin: 1.5rem 0;
  }
  .aparat-error a {
    color: #F5A623;
    text-decoration: underline;
  }
</style>