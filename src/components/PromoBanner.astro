---
import banner from '../content/settings/banner.json';

const {
  enabled,
  desktopImage,
  mobileImage,
  alt,
  link,
  youtubeUrl,
  aparatUrl,
  baleUrl,
} = banner;

const hasDesktop = !!desktopImage;
const hasMobile = !!mobileImage;
const show = enabled && (hasDesktop || hasMobile);
const hasButtons = !!(youtubeUrl || aparatUrl || baleUrl);

const YouTubeIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>`;
const AparatIcon = `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg>`;
const BaleIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`;
---
{show && (
  <section class="promo-banner-section" aria-label="بنر مسکن‌تاک">
    <div class="container">
      <div class="promo-banner">
        {/* Desktop layout: banner + buttons overlay on the right */}
        {hasDesktop && (
          <div class="promo-banner-desktop">
            {link ? (
              <a href={link} class="promo-banner-link" aria-label={alt}>
                <img src={desktopImage} alt={alt} loading="lazy" />
              </a>
            ) : (
              <img src={desktopImage} alt={alt} loading="lazy" class="promo-banner-img" />
            )}

            {hasButtons && (
              <div class="promo-banner-buttons">
                {youtubeUrl && (
                  <a href={youtubeUrl} target="_blank" rel="noopener" class="promo-btn promo-btn--youtube" aria-label="یوتیوب">
                    <span class="promo-btn-icon" set:html={YouTubeIcon}></span>
                    <span class="promo-btn-label">یوتیوب</span>
                  </a>
                )}
                {aparatUrl && (
                  <a href={aparatUrl} target="_blank" rel="noopener" class="promo-btn promo-btn--aparat" aria-label="آپارات">
                    <span class="promo-btn-icon" set:html={AparatIcon}></span>
                    <span class="promo-btn-label">آپارات</span>
                  </a>
                )}
                {baleUrl && (
                  <a href={baleUrl} target="_blank" rel="noopener" class="promo-btn promo-btn--bale" aria-label="بله">
                    <span class="promo-btn-icon" set:html={BaleIcon}></span>
                    <span class="promo-btn-label">بله</span>
                  </a>
                )}
              </div>
            )}
          </div>
        )}

        {/* Mobile layout: only the image, no buttons */}
        {hasMobile && (
          <div class="promo-banner-mobile">
            {link ? (
              <a href={link} class="promo-banner-link" aria-label={alt}>
                <img src={mobileImage} alt={alt} loading="lazy" />
              </a>
            ) : (
              <img src={mobileImage} alt={alt} loading="lazy" class="promo-banner-img" />
            )}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .promo-banner-section {
    padding: 0.5rem 0 1.5rem;
  }

  .promo-banner {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a24 0%, #101117 100%);
  }

  /* ---- Desktop ---- */
  .promo-banner-desktop {
    position: relative;
    display: block;
    aspect-ratio: 1600 / 400;
    width: 100%;
  }
  .promo-banner-desktop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }
  .promo-banner-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .promo-banner-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .promo-banner-buttons {
    position: absolute;
    top: 50%;
    right: 2rem;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 10px;
    z-index: 3;
  }

  .promo-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    min-width: 130px;
    border-radius: 14px;
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
    color: #fff;
    background: rgba(10,11,16,.62);
    -webkit-backdrop-filter: blur(14px) saturate(1.6);
    backdrop-filter: blur(14px) saturate(1.6);
    border: 1px solid rgba(255,255,255,.18);
    box-shadow: 0 8px 22px -8px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.12);
    transition: transform .25s var(--ease), background .25s var(--ease), border-color .25s var(--ease), box-shadow .25s var(--ease);
  }
  .promo-btn:hover {
    transform: translateY(-2px);
    background: rgba(10,11,16,.85);
    border-color: rgba(255,255,255,.35);
  }
  .promo-btn:active { transform: translateY(0) scale(.98); }

  .promo-btn-icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }
  .promo-btn-icon svg { width: 100%; height: 100%; }

  .promo-btn-label {
    font-family: inherit;
    line-height: 1;
    letter-spacing: .01em;
  }

  /* Brand colors */
  .promo-btn--youtube { color: #ff5c5c; border-color: rgba(255,92,92,.35); }
  .promo-btn--youtube:hover { color: #fff; background: rgba(220,40,40,.85); border-color: rgba(255,92,92,.6); }

  .promo-btn--aparat { color: #F5A623; border-color: rgba(245,166,35,.4); }
  .promo-btn--aparat:hover { color: var(--on-brand); background: linear-gradient(135deg, #F5A623, #DC8A0F); border-color: transparent; }

  .promo-btn--bale { color: #6FD3C7; border-color: rgba(111,211,199,.35); }
  .promo-btn--bale:hover { color: #fff; background: rgba(46,160,140,.85); border-color: rgba(111,211,199,.6); }

  /* ---- Mobile ---- */
  .promo-banner-mobile {
    display: none;
    width: 100%;
  }
  .promo-banner-mobile img,
  .promo-banner-mobile .promo-banner-link img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: inherit;
  }

  /* ---- Responsive switch ---- */
  @media (max-width: 900px) {
    .promo-banner-section { padding: 0.25rem 0 1rem; }
    .promo-banner-desktop { display: none; }
    .promo-banner-mobile { display: block; }
    .promo-banner { border-radius: 18px; }
  }

  @media (min-width: 901px) {
    .promo-banner-mobile { display: none; }
    .promo-banner-desktop { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-btn { transition: none; }
  }
</style>
