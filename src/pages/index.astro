---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = await getCollection('articles');
const sorted = allArticles.sort((a, b) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const featured = sorted.find(a => a.data.featured) ?? sorted[0];
const newsHero = sorted[0];
const newsList = sorted.slice(1, 6);
---
<BaseLayout title="صفحه اصلی">
  <section class="hero">
    <div class="container">
      <div class="hero-card reveal">

        <div class="hero-visual">
          <img src={featured?.data.cover ?? "https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=1400&q=80&auto=format&fit=crop"} alt={featured?.data.title ?? "آخرین قسمت مسکن‌تاک"}>
          <span class="hero-badge-top">
            <span class="dot" aria-hidden="true"></span>
            جدیدترین قسمت
          </span>
          <button class="hero-play" aria-label="پخش ویدیو">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <span class="hero-duration">{featured?.data.duration ?? "۵۸:۱۲"}</span>
        </div>

        <div class="hero-content">
          <span class="hero-meta">قسمت جدید · فصل اول</span>
          <h1 class="hero-title">
            {featured?.data.title ?? "مسکن‌تاک — گفتگوهای تخصصی بازار مسکن"}
          </h1>
          <p class="hero-desc">
            {featured?.data.description ?? "هر هفته یک گفتگوی بی‌پرده با کارشناسان مسکن، املاک و ساختمان."}
          </p>
          <div class="hero-actions">
            {featured ? (
              <a href={`/articles/${featured.id}/`} class="hero-cta hero-cta-brand">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg>
                <span>مشاهده و خواندن</span>
              </a>
            ) : (
              <a href="#" class="hero-cta hero-cta-brand">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg>
                <span>تماشا در آپارات</span>
              </a>
            )}
            <a href="#articles" class="hero-cta hero-cta-ghost">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 19.5V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v13.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              <span>آخرین مطالب</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section" id="episodes">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">قسمت‌های <span>مسکن‌تاک</span></h2>
        <a href="#" class="section-link">
          آرشیو برنامه‌ها
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
      </div>

      <div class="bento">
        <article class="bento-card bc-amber reveal">
          <div class="v-thumb">
            <img src="https://images.unsplash.com/photo-1531403009284-440f080d1e12?w=700&q=80&auto=format&fit=crop" alt="">
            <div class="v-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <span class="v-time">۴۵:۲۰</span>
          </div>
          <div class="bento-meta">
            <span class="bento-tag">تحلیل بازار</span>
            <h3 class="bento-title">حباب قیمت مسکن در پایتخت</h3>
            <div class="bento-foot"><span>دکتر مرادی</span><span>۲ هفته پیش</span></div>
          </div>
        </article>

        <article class="bento-card bc-indigo reveal">
          <div class="v-thumb">
            <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=700&q=80&auto=format&fit=crop" alt="">
            <div class="v-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <span class="v-time">۵۲:۱۰</span>
          </div>
          <div class="bento-meta">
            <span class="bento-tag">مصاحبه اختصاصی</span>
            <h3 class="bento-title">گفتگو با کارشناس اقتصاد مسکن</h3>
            <div class="bento-foot"><span>مهندس کاظمی</span><span>هفته گذشته</span></div>
          </div>
        </article>

        <article class="bento-card bc-coral reveal">
          <div class="v-thumb">
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=700&q=80&auto=format&fit=crop" alt="">
            <div class="v-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <span class="v-time">۴۱:۰۵</span>
          </div>
          <div class="bento-meta">
            <span class="bento-tag">قوانین و مقررات</span>
            <h3 class="bento-title">قانون جهش تولید مسکن به کجا رسید؟</h3>
            <div class="bento-foot"><span>علی رستگار</span><span>۲ هفته پیش</span></div>
          </div>
        </article>

        <article class="bento-card bc-light reveal">
          <div class="v-thumb">
            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=700&q=80&auto=format&fit=crop" alt="">
            <div class="v-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <span class="v-time">۳۸:۴۰</span>
          </div>
          <div class="bento-meta">
            <span class="bento-tag">وام و تسهیلات</span>
            <h3 class="bento-title">وام مسکن جوانان؛ فرصت یا تله بانکی؟</h3>
            <div class="bento-foot"><span>حسین نوری</span><span>۳ هفته پیش</span></div>
          </div>
        </article>

        <div class="split-stack">
          <article class="bento-card bc-amber-soft compact-h reveal">
            <div class="v-thumb">
              <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=500&q=80&auto=format&fit=crop" alt="">
              <div class="v-play" style="width:30px;height:30px;">
                <svg viewBox="0 0 24 24" style="width:11px;height:11px;"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <span class="v-time" style="font-size:.55rem;padding:2px 5px;">۰۳:۱۰</span>
            </div>
            <div class="bento-meta">
              <span class="bento-tag">کوتاه</span>
              <h4 class="bento-title">چرا اجاره‌ها بالا رفت؟</h4>
              <span style="font-size:.58rem;font-weight:800;opacity:.9;display:block;margin-top:3px;color:var(--brand);">مشاهده ↗</span>
            </div>
          </article>

          <article class="bento-card bc-indigo-hi compact-h reveal">
            <div class="v-thumb">
              <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=500&q=80&auto=format&fit=crop" alt="">
              <div class="v-play" style="width:30px;height:30px;">
                <svg viewBox="0 0 24 24" style="width:11px;height:11px;"><path d="M8 5v14l11-7z"/></svg>
              </div>
              <span class="v-time" style="font-size:.55rem;padding:2px 5px;">۰۴:۴۵</span>
            </div>
            <div class="bento-meta">
              <span class="pill-badge">★ ویژه</span>
              <h4 class="bento-title">پیش‌بینی بازار ۱۴۰۵</h4>
            </div>
          </article>
        </div>

        <article class="bento-card bc-indigo reveal">
          <div class="v-thumb">
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=700&q=80&auto=format&fit=crop" alt="">
            <div class="v-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
            <span class="v-time">۴۹:۱۵</span>
          </div>
          <div class="bento-meta">
            <span class="bento-tag">ساخت‌وساز</span>
            <h3 class="bento-title">چالش‌های ساخت‌وساز در ایران</h3>
            <div class="bento-foot"><span>علی رستگار</span><span>۱ ماه پیش</span></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="reels" style="padding-top:0">
    <div class="container">
      <div class="reels-panel reveal">
        <div class="reels-head">
          <h2 class="section-title">
            <svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
            برش‌های کوتاه <span class="accent">مسکن‌تاک</span>
          </h2>
          <div class="reel-arrows">
            <button id="reelPrev" aria-label="قبلی">
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button id="reelNext" aria-label="بعدی">
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        <div class="reels-track" id="reelsTrack">
          <a href="#" class="reel">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=500&q=80&auto=format&fit=crop" alt="">
            <span class="reel-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg></span>
            <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="reel-info">
              <h4>خلاصه صحبت‌های وزیر</h4>
              <span>۰:۵۸ · ۱۲۴ هزار بازدید</span>
            </span>
          </a>

          <a href="#" class="reel">
            <img src="https://images.unsplash.com/photo-1502672260266-1c1e5250adfd?w=500&q=80&auto=format&fit=crop" alt="">
            <span class="reel-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg></span>
            <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="reel-info">
              <h4>چرا اجاره‌ها بالا رفت؟</h4>
              <span>۱:۱۲ · ۸۹ هزار بازدید</span>
            </span>
          </a>

          <a href="#" class="reel">
            <img src="https://images.unsplash.com/photo-1449844908441-8829872d2607?w=500&q=80&auto=format&fit=crop" alt="">
            <span class="reel-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg></span>
            <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="reel-info">
              <h4>راهکار خرید خانه با بودجه کم</h4>
              <span>۰:۴۵ · ۶۷ هزار بازدید</span>
            </span>
          </a>

          <a href="#" class="reel">
            <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=500&q=80&auto=format&fit=crop" alt="">
            <span class="reel-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg></span>
            <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="reel-info">
              <h4>پیش‌بینی بازار تا پایان سال</h4>
              <span>۱:۰۳ · ۵۴ هزار بازدید</span>
            </span>
          </a>

          <a href="#" class="reel">
            <img src="https://images.unsplash.com/photo-1558036117-15d82a90b968?w=500&q=80&auto=format&fit=crop" alt="">
            <span class="reel-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg></span>
            <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="reel-info">
              <h4>نکته‌ای که در اجاره‌نامه نباید فراموش کنی</h4>
              <span>۰:۵۲ · ۴۸ هزار بازدید</span>
            </span>
          </a>

          <a href="#" class="reel">
            <img src="https://images.unsplash.com/photo-1580587771525-78b9dba3b914?w=500&q=80&auto=format&fit=crop" alt="">
            <span class="reel-badge"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg></span>
            <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
            <span class="reel-info">
              <h4>خانه‌های کلنگی؛ بخرم یا نه؟</h4>
              <span>۱:۰۸ · ۴۱ هزار بازدید</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="articles" style="padding-top:0">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">اخبار و <span class="accent">مقالات</span></h2>
        <a href="/articles/" class="section-link">
          همه مطالب
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
      </div>

      {newsHero ? (
        <div class="news-grid">
          <a href={`/articles/${newsHero.id}/`} class="news-hero reveal">
            <img src={newsHero.data.cover ?? "https://images.unsplash.com/photo-1480074568708-e7b720bb3f09?w=1400&q=80&auto=format&fit=crop"} alt={newsHero.data.title}>
            <div class="news-hero-body">
              <span class="news-hero-badge">{newsHero.data.category}</span>
              <h3>{newsHero.data.title}</h3>
              <div class="news-hero-meta">
                <span>{newsHero.data.author}</span>
                <span class="sep"></span>
                <span>{newsHero.data.publishDate.toLocaleDateString('fa-IR')}</span>
              </div>
            </div>
          </a>

          <div class="news-stack reveal">
            {newsList.length > 0 ? newsList.map((article, i) => (
              <a href={`/articles/${article.id}/`} class="news-card">
                <div class="news-card-thumb">
                  <img src={article.data.cover ?? "https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=300&q=80&auto=format&fit=crop"} alt={article.data.title}>
                </div>
                <div class="news-card-body">
                  <span class={`news-card-cat ${i % 3 === 0 ? 'cat-amber' : i % 3 === 1 ? 'cat-coral' : 'cat-light'}`}>
                    {article.data.category}
                  </span>
                  <h4>{article.data.title}</h4>
                  <span class="news-card-date">{article.data.publishDate.toLocaleDateString('fa-IR')}</span>
                </div>
              </a>
            )) : (
              <div style="padding:2rem;text-align:center;color:var(--text-dim);background:var(--card);border:1px solid var(--line);border-radius:18px;">
                <p style="font-size:.9rem;">هنوز مقاله‌ای منتشر نشده.</p>
              </div>
            )}
          </div>
        </div>
      ) : (
        <div style="padding:3rem;text-align:center;color:var(--text-dim);background:var(--card);border:1px solid var(--line);border-radius:24px;">
          <h3 style="font-size:1.2rem;margin-bottom:.5rem;color:#fff;">هنوز مقاله‌ای منتشر نشده</h3>
          <p style="font-size:.9rem;">اولین مقاله را از پنل مدیریت اضافه کنید.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>