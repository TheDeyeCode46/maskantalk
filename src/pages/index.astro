---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AparatEmbed from '../components/AparatEmbed.astro';
import { extractAparatHash } from '../lib/aparat';

const all = await getCollection('articles');
const sorted = all.sort((a, b) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const VIDEO_CATS = ['ویدیو', 'کوتاه'];

const videos = sorted.filter(a => a.data.category === 'ویدیو');
const reels = sorted.filter(a => a.data.category === 'کوتاه');
const articles = sorted.filter(a => !VIDEO_CATS.includes(a.data.category));

const featured = sorted.find(a => a.data.featured) ?? sorted[0];
const heroIsVideo = featured && VIDEO_CATS.includes(featured.data.category);
const heroHash = featured?.data.aparatHash
  ? extractAparatHash(featured.data.aparatHash)
  : null;
const heroHasVideo = !!(heroIsVideo && heroHash);

const newsHero = articles[0];
const newsList = articles.slice(1, 6);
---
<BaseLayout title="صفحه اصلی">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-card reveal">

        <div class="hero-visual">
          {heroHasVideo && featured ? (
            <div class="hero-embed">
              <AparatEmbed
                hash={featured.data.aparatHash!}
                title={featured.data.title}
                aspect="16:9"
              />
            </div>
          ) : (
            <>
              <img src={featured?.data.cover ?? "/images/hero.jpg"} alt={featured?.data.title ?? "مسکن‌تاک"}>
              <span class="hero-badge-top">
                <span class="dot" aria-hidden="true"></span>
                جدیدترین
              </span>
              {featured && (
                <a href={`/articles/${featured.id}/`} class="hero-link-overlay" aria-label="مشاهده"></a>
              )}
              {featured?.data.duration && <span class="hero-duration">{featured.data.duration}</span>}
            </>
          )}
        </div>

        <div class="hero-content">
          <span class="hero-meta">{featured?.data.category ?? 'مسکن‌تاک'}</span>
          <h1 class="hero-title">
            {featured?.data.title ?? "مسکن‌تاک — گفتگوهای تخصصی بازار مسکن"}
          </h1>
          <p class="hero-desc">
            {featured?.data.description ?? "هر هفته یک گفتگوی بی‌پرده با کارشناسان مسکن، املاک و ساختمان."}
          </p>
          <div class="hero-actions">
            {featured && (
              <a href={`/articles/${featured.id}/`} class="hero-cta hero-cta-brand">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg>
                <span>{heroHasVideo ? 'صفحه قسمت' : 'خواندن'}</span>
              </a>
            )}
            <a href="#articles" class="hero-cta hero-cta-ghost">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 19.5V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v13.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              <span>آخرین مطالب</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- VIDEOS -->
  <section class="section" id="episodes">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">قسمت‌های <span>مسکن‌تاک</span></h2>
        <a href="/videos/" class="section-link">
          آرشیو برنامه‌ها
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
      </div>

      {videos.length === 0 ? (
        <div class="empty-state">هنوز ویدیویی منتشر نشده. از پنل مدیریت اضافه کنید.</div>
      ) : (
        <div class="bento">
          {videos.slice(0, 7).map((v, i) => {
            const colors = ['bc-amber', 'bc-indigo', 'bc-coral', 'bc-light', 'bc-amber-soft', 'bc-indigo-hi'];
            const color = colors[i % colors.length];
            return (
              <a href={`/articles/${v.id}/`} class={`bento-card ${color} reveal`}>
                <div class="v-thumb">
                  {v.data.cover ? <img src={v.data.cover} alt="" /> : <div class="ph-placeholder"></div>}
                  <div class="v-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                  {v.data.duration && <span class="v-time">{v.data.duration}</span>}
                </div>
                <div class="bento-meta">
                  <span class="bento-tag">{v.data.tags[0] ?? 'برنامه'}</span>
                  <h3 class="bento-title">{v.data.title}</h3>
                  <div class="bento-foot"><span>{v.data.author}</span><span>{v.data.publishDate.toLocaleDateString('fa-IR')}</span></div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- REELS -->
  <section class="section" id="reels" style="padding-top:0">
    <div class="container">
      <div class="reels-panel reveal">
        <div class="reels-head">
          <h2 class="section-title">
            <svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
            برش‌های کوتاه <span class="accent">مسکن‌تاک</span>
          </h2>
          <div class="reel-arrows">
            <a href="/reels/" class="section-link" style="margin-inline-end:.5rem">همه</a>
            <button id="reelPrev" aria-label="قبلی">
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button id="reelNext" aria-label="بعدی">
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        {reels.length === 0 ? (
          <div class="empty-state" style="margin:1rem 1.35rem">هنوز کلیپ کوتاهی منتشر نشده.</div>
        ) : (
          <div class="reels-track" id="reelsTrack">
            {reels.map(r => {
              const hash = extractAparatHash(r.data.aparatHash);
              return (
                <button
                  type="button"
                  class="reel"
                  data-aparat-hash={hash ?? ''}
                  data-instagram={r.data.instagramUrl ?? ''}
                  data-title={r.data.title}
                  data-article={r.id}
                  aria-label={r.data.title}
                >
                  {r.data.cover ? <img src={r.data.cover} alt="" /> : <div class="ph-placeholder full"></div>}
                  <span class="reel-badge">
                    <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                  <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
                  <span class="reel-info">
                    <h4>{r.data.title}</h4>
                    <span>{r.data.duration ?? ''}{r.data.duration ? ' · ' : ''}{r.data.category}</span>
                  </span>
                </button>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="section" id="articles" style="padding-top:0">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">اخبار و <span class="accent">مقالات</span></h2>
        <a href="/articles/" class="section-link">
          همه مطالب
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
      </div>

      {articles.length === 0 ? (
        <div class="empty-state">هنوز مقاله‌ای منتشر نشده.</div>
      ) : (
        <div class="news-grid">
          <a href={`/articles/${newsHero.id}/`} class="news-hero reveal">
            {newsHero.data.cover ? <img src={newsHero.data.cover} alt={newsHero.data.title} /> : <div class="ph-placeholder full"></div>}
            <div class="news-hero-body">
              <span class="news-hero-badge">{newsHero.data.category}</span>
              <h3>{newsHero.data.title}</h3>
              <div class="news-hero-meta">
                <span>{newsHero.data.author}</span>
                <span class="sep"></span>
                <span>{newsHero.data.publishDate.toLocaleDateString('fa-IR')}</span>
              </div>
            </div>
          </a>

          <div class="news-stack reveal">
            {newsList.map((a, i) => (
              <a href={`/articles/${a.id}/`} class="news-card">
                <div class="news-card-thumb">
                  {a.data.cover ? <img src={a.data.cover} alt="" /> : <div class="ph-placeholder full"></div>}
                </div>
                <div class="news-card-body">
                  <span class={`news-card-cat ${i % 3 === 0 ? 'cat-amber' : i % 3 === 1 ? 'cat-coral' : 'cat-light'}`}>
                    {a.data.category}
                  </span>
                  <h4>{a.data.title}</h4>
                  <span class="news-card-date">{a.data.publishDate.toLocaleDateString('fa-IR')}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- VIDEO MODAL -->
  <div class="video-modal" id="videoModal" hidden>
    <div class="video-modal-backdrop" data-close></div>
    <div class="video-modal-inner">
      <button class="video-modal-close" data-close aria-label="بستن">×</button>
      <div class="video-modal-frame" id="videoModalFrame"></div>
      <div class="video-modal-foot">
        <h3 id="videoModalTitle">—</h3>
        <a id="videoModalArticle" href="#" class="video-modal-article-link">صفحه کامل ↗</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Hero player fills the frame */
  .hero-embed {
    position: absolute;
    inset: 0;
    padding: 0;
    z-index: 1;
  }
  .hero-embed :global(.aparat-wrap) {
    border-radius: 0;
    height: 100%;
    padding-bottom: 0 !important;
    margin: 0;
  }
  .hero-embed :global(.aparat-wrap iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero-visual:has(.hero-embed)::after {
    background: linear-gradient(
      to left,
      transparent 30%,
      rgba(22,23,31,.15) 55%,
      rgba(22,23,31,.65) 85%,
      var(--card) 100%
    );
    pointer-events: none;
  }

  /* Reels are buttons now, not links */
  .reel {
    background: none;
    border: 1px solid var(--line);
    padding: 0;
    font-family: inherit;
    cursor: pointer;
    text-align: inherit;
    color: inherit;
  }

  /* Video modal */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .video-modal[hidden] { display: none; }
  .video-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .video-modal-inner {
    position: relative;
    z-index: 2;
    background: #101117;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 20px;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow: auto;
    box-shadow: 0 40px 80px -20px rgba(0,0,0,.8);
  }
  .video-modal-close {
    position: absolute;
    top: .6rem;
    left: .6rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0,0,0,.6);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    z-index: 3;
    cursor: pointer;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.15);
  }
  .video-modal-close:hover { background: #E84C3D; }
  .video-modal-frame { width: 100%; }
  .video-modal-frame :global(.aparat-wrap) {
    border-radius: 20px 20px 0 0;
    margin: 0;
  }
  .video-modal-foot {
    padding: .9rem 1rem 1.1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .video-modal-foot h3 {
    font-size: .95rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
    flex: 1;
    min-width: 0;
  }
  .video-modal-article-link {
    color: #F5A623;
    font-size: .8rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .video-modal-article-link:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .video-modal-inner { max-width: 340px; }
  }
</style>

<script is:inline>
(function(){
  'use strict';

  // ===== Reels carousel =====
  var track = document.getElementById('reelsTrack');
  var prevBtn = document.getElementById('reelPrev');
  var nextBtn = document.getElementById('reelNext');
  var reels = track ? track.querySelectorAll('.reel') : [];

  function getReelStep(){
    if (!track || !reels.length) return 200;
    var first = reels[0];
    var style = window.getComputedStyle(track);
    var gap = parseFloat(style.gap || style.columnGap) || 12;
    return first.offsetWidth + gap;
  }

  if (track && prevBtn && nextBtn) {
    nextBtn.addEventListener('click', function(){
      track.scrollBy({ left: -getReelStep(), behavior: 'smooth' });
    });
    prevBtn.addEventListener('click', function(){
      track.scrollBy({ left: getReelStep(), behavior: 'smooth' });
    });
  }

  // ===== Reels center highlight (mobile) =====
  if (track && reels.length) {
    var rafId = null;
    var isMobile = function(){ return window.matchMedia('(max-width: 900px)').matches; };
    function updateCenter(){
      rafId = null;
      if (!isMobile()){
        reels.forEach(function(r){ r.classList.remove('is-center'); });
        return;
      }
      var trackRect = track.getBoundingClientRect();
      var trackCenter = trackRect.left + trackRect.width / 2;
      var best = null, bestDist = Infinity;
      reels.forEach(function(r){
        var rect = r.getBoundingClientRect();
        var center = rect.left + rect.width / 2;
        var dist = Math.abs(center - trackCenter);
        if (dist < bestDist){ bestDist = dist; best = r; }
      });
      reels.forEach(function(r){
        r.classList.toggle('is-center', r === best);
      });
    }
    function scheduleCenter(){
      if (rafId) return;
      rafId = requestAnimationFrame(updateCenter);
    }
    track.addEventListener('scroll', scheduleCenter, { passive: true });
    window.addEventListener('resize', scheduleCenter);
    updateCenter();
    setTimeout(updateCenter, 200);
    setTimeout(updateCenter, 600);
  }

  // ===== Video modal =====
  var modal = document.getElementById('videoModal');
  var modalFrame = document.getElementById('videoModalFrame');
  var modalTitle = document.getElementById('videoModalTitle');
  var modalArticle = document.getElementById('videoModalArticle');

  function openModal(hash, title, articleId, instagramUrl){
    if (!modal) return;
    modalFrame.innerHTML = '';
    if (hash){
      var wrap = document.createElement('div');
      wrap.className = 'aparat-wrap aspect-vertical';
      wrap.style.cssText = 'position:relative;padding-bottom:177.78%;height:0;border-radius:20px 20px 0 0;overflow:hidden;background:#050508;';
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.aparat.com/video/video/embed/videohash/' + hash + '/vt/frame?autoplay=1';
      iframe.title = title || 'ویدیو';
      iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('webkitallowfullscreen', '');
      iframe.setAttribute('mozallowfullscreen', '');
      iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      iframe.setAttribute('frameborder', '0');
      iframe.setAttribute('scrolling', 'no');
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';
      wrap.appendChild(iframe);
      modalFrame.appendChild(wrap);
    } else if (instagramUrl){
      var box = document.createElement('div');
      box.style.cssText = 'padding:3rem 1.5rem;text-align:center;color:#aaa;';
      box.innerHTML = '<p style="margin:0 0 1rem;font-size:.9rem;">این کلیپ از اینستاگرام است. برای تماشا روی دکمه زیر بزنید.</p>'
        + '<a href="' + instagramUrl + '" target="_blank" rel="noopener" style="display:inline-block;padding:.7rem 1.3rem;background:linear-gradient(135deg,#E84C3D,#C73B2D);color:#fff;font-weight:700;border-radius:12px;text-decoration:none;">مشاهده در اینستاگرام ↗</a>';
      modalFrame.appendChild(box);
    } else {
      var err = document.createElement('div');
      err.style.cssText = 'padding:3rem 1.5rem;text-align:center;color:#aaa;';
      err.textContent = 'ویدیویی برای این آیتم ثبت نشده.';
      modalFrame.appendChild(err);
    }
    if (modalTitle) modalTitle.textContent = title || '';
    if (modalArticle && articleId){
      modalArticle.href = '/articles/' + articleId + '/';
      modalArticle.style.display = '';
    } else if (modalArticle){
      modalArticle.style.display = 'none';
    }
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal(){
    if (!modal) return;
    modal.hidden = true;
    if (modalFrame) modalFrame.innerHTML = '';
    document.body.style.overflow = '';
  }

  if (modal){
    modal.addEventListener('click', function(e){
      if (e.target && e.target.hasAttribute('data-close')) closeModal();
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  }

  document.querySelectorAll('.reel').forEach(function(r){
    r.addEventListener('click', function(e){
      e.preventDefault();
      var hash = r.getAttribute('data-aparat-hash') || '';
      var ig = r.getAttribute('data-instagram') || '';
      var title = r.getAttribute('data-title') || '';
      var articleId = r.getAttribute('data-article') || '';
      openModal(hash, title, articleId, ig);
    });
  });

  // ===== Bottom nav scroll spy =====
  var bnItems = document.querySelectorAll('.bn-item');
  var secs = ['top', 'episodes', 'reels', 'articles'];
  var contactEl = document.getElementById('contact');
  function updateBN(){
    var y = window.scrollY + 220;
    var viewportBottom = window.scrollY + window.innerHeight;
    var pageBottom = document.documentElement.scrollHeight - 40;
    var atFooter = false;
    if (contactEl) {
      var contactTop = contactEl.offsetTop;
      if (y >= contactTop - 100) atFooter = true;
    }
    if (viewportBottom >= pageBottom) atFooter = true;
    if (atFooter) {
      bnItems.forEach(function(item){ item.classList.remove('active'); });
      return;
    }
    var cur = 'top';
    secs.forEach(function(id){
      var el = document.getElementById(id);
      if (el && el.offsetTop <= y) cur = id;
    });
    bnItems.forEach(function(item){
      item.classList.toggle('active', item.dataset.nav === cur);
    });
  }
  window.addEventListener('scroll', updateBN, { passive: true });
  window.addEventListener('resize', updateBN);
  updateBN();

  // ===== Newsletter =====
  var form = document.getElementById('newsForm');
  if (form) {
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var email = document.getElementById('newsEmail').value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        alert('لطفاً یک ایمیل معتبر وارد کنید.');
        return;
      }
      alert('ممنون! ایمیل شما در خبرنامه مسکن‌تاک ثبت شد.');
      form.reset();
    });
  }

  // ===== Reveal on scroll =====
  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting) {
          en.target.classList.add('visible');
          obs.unobserve(en.target);
        }
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(function(el){ obs.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('visible'); });
  }
})();
</script>