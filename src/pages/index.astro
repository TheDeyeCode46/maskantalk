---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { extractAparatHash } from '../lib/aparat';
import { normCat, toFa } from '../lib/categories'; // eslint-disable-line
import { faDigits } from '../lib/format';

const all = await getCollection('articles');
const sorted = all.sort((a, b) =>
  b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const isVideo = (a) => normCat(a.data.category) === 'ویدیو';
const isReel = (a) => normCat(a.data.category) === 'کوتاه';
const isArticle = (a) => !isVideo(a) && !isReel(a);

const videos = sorted.filter(isVideo);
const reels = sorted.filter(isReel);
const articles = sorted.filter(isArticle);

const featured = sorted.find(a => a.data.featured) ?? sorted[0];
const heroIsVideo = featured && (isVideo(featured) || isReel(featured));
const heroHash = featured?.data.aparatHash ? extractAparatHash(featured.data.aparatHash) : null;
const heroHasVideo = !!(heroIsVideo && heroHash);
const heroEpisode = featured?.data.episode;
const heroBtnText = heroEpisode
  ? `صفحه قسمت ${toFa(heroEpisode)}`
  : (heroIsVideo ? 'صفحه قسمت' : 'خواندن مطلب');

const newsHero = articles[0];
const newsList = articles.slice(1, 6);
---
<BaseLayout title="صفحه اصلی">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-card reveal">
        <div class="hero-visual">
          <img
            class="hero-thumb"
            src={featured?.data.cover ?? '/images/hero.jpg'}
            alt={featured?.data.title ?? 'مسکن‌تاک'}
            loading="eager"
          />
          <span class="hero-badge-top">
            <span class="dot" aria-hidden="true"></span>
            جدیدترین
          </span>
          {featured?.data.duration && (
            <span class="hero-duration">{faDigits(featured.data.duration)}</span>
          )}
          {heroHasVideo && featured ? (
            <button
              type="button"
              class="hero-play"
              data-hero-hash={heroHash}
              data-hero-title={featured.data.title}
              aria-label="پخش ویدیو"
            >
              <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </button>
          ) : featured ? (
            <a href={`/articles/${featured.id}/`} class="hero-link-overlay" aria-label="مشاهده"></a>
          ) : null}
        </div>

        <div class="hero-content">
          <span class="hero-meta">{featured?.data.category ?? 'مسکن‌تاک'}</span>
          <h1 class="hero-title">
            {featured?.data.title ?? 'مسکن‌تاک — گفتگوهای تخصصی بازار مسکن'}
          </h1>
          <p class="hero-desc">
            {featured?.data.description ?? 'هر هفته یک گفتگوی بی‌پرده با کارشناسان مسکن، املاک و ساختمان.'}
          </p>
          <div class="hero-actions">
            {featured && (
              <a href={`/articles/${featured.id}/`} class="hero-cta hero-cta-brand">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l7 4.5-7 4.5z"/></svg>
                <span>{heroBtnText}</span>
              </a>
            )}
            <a href="#articles" class="hero-cta hero-cta-ghost">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 19.5V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v13.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              <span>آخرین مطالب</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEOS -->
  <section class="section" id="episodes">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">قسمت‌های <span>مسکن‌تاک</span></h2>
        <a href="/videos/" class="section-link">
          آرشیو برنامه‌ها
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
      </div>

      {videos.length === 0 ? (
        <div class="empty-state">هنوز ویدیویی منتشر نشده. از پنل مدیریت اضافه کنید.</div>
      ) : (
        <div class="bento">
          {videos.slice(0, 9).map((v, i) => {
            const colors = ['bc-amber', 'bc-indigo', 'bc-coral', 'bc-light', 'bc-amber-soft', 'bc-indigo-hi'];
            const color = colors[i % colors.length];
            return (
              <a href={`/articles/${v.id}/`} class={`bento-card ${color} reveal`}>
                <div class="v-thumb">
                  {v.data.cover
                    ? <img src={v.data.cover} alt="" loading="lazy" />
                    : <div class="ph-placeholder">تصویر</div>}
                  <div class="v-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>
                  {v.data.duration && <span class="v-time">{faDigits(v.data.duration)}</span>}
                </div>
                <div class="bento-meta">
                  <span class="bento-tag">{v.data.tags[0] ?? 'برنامه'}</span>
                  <h3 class="bento-title">{v.data.title}</h3>
                  <div class="bento-foot">
                    <span>{v.data.author}</span>
                    <span>{toFa(v.data.publishDate.toLocaleDateString('fa-IR'))}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- REELS -->
  <section class="section" id="reels" style="padding-top:0">
    <div class="container">
      <div class="reels-panel reveal">
        <div class="reels-head">
          <h2 class="section-title">
            <svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"/></svg>
            برش‌های کوتاه <span class="accent">مسکن‌تاک</span>
          </h2>
          <div class="reel-arrows">
            <a href="/reels/" class="section-link" style="margin-inline-end:.5rem">آرشیو ویدیوهای کوتاه</a>
            <button id="reelPrev" aria-label="قبلی">
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button id="reelNext" aria-label="بعدی">
              <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        {reels.length === 0 ? (
          <div class="empty-state" style="margin:1rem 1.5rem">هنوز کلیپ کوتاهی منتشر نشده.</div>
        ) : (
          <div class="reels-track" id="reelsTrack">
            {reels.slice(0, 12).map(r => {
              const hash = r.data.aparatHash ? extractAparatHash(r.data.aparatHash) : null;
              return (
                <button
                  type="button"
                  class="reel"
                  data-video-open
                  data-hash={hash ?? ''}
                  data-title={r.data.title}
                  data-article={r.id}
                  data-instagram={r.data.instagramUrl ?? ''}
                  aria-label={r.data.title}
                >
                  {r.data.cover ? <img src={r.data.cover} alt="" loading="lazy" /> : <div class="ph-placeholder full"></div>}
                  <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
                  <span class="reel-info">
                    <h4>{r.data.title}</h4>
                    <span>{r.data.duration ? faDigits(r.data.duration) + ' · ' : ''}{toFa(r.data.publishDate.toLocaleDateString('fa-IR'))}</span>
                  </span>
                </button>
              );
            })}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ARTICLES -->
  <section class="section" id="articles" style="padding-top:0">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">اخبار و <span class="accent">مقالات</span></h2>
        <a href="/news/" class="section-link">
          همه مطالب
          <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
      </div>

      {articles.length === 0 ? (
        <div class="empty-state">هنوز مقاله‌ای منتشر نشده.</div>
      ) : (
        <div class="news-grid">
          <a href={`/articles/${newsHero.id}/`} class="news-hero reveal">
            {newsHero.data.cover ? <img src={newsHero.data.cover} alt={newsHero.data.title} loading="lazy" /> : <div class="ph-placeholder full"></div>}
            <div class="news-hero-body">
              <span class="news-hero-badge">{newsHero.data.category}</span>
              <h3>{newsHero.data.title}</h3>
              <div class="news-hero-meta">
                <span>{newsHero.data.author}</span>
                <span class="sep"></span>
                <span>{toFa(newsHero.data.publishDate.toLocaleDateString('fa-IR'))}</span>
              </div>
            </div>
          </a>

          <div class="news-stack reveal">
            {newsList.map((a, i) => (
              <a href={`/articles/${a.id}/`} class="news-card">
                <div class="news-card-thumb">
                  {a.data.cover ? <img src={a.data.cover} alt="" loading="lazy" /> : <div class="ph-placeholder full"></div>}
                </div>
                <div class="news-card-body">
                  <span class={`news-card-cat ${i % 3 === 0 ? 'cat-amber' : i % 3 === 1 ? 'cat-coral' : 'cat-light'}`}>
                    {a.data.category}
                  </span>
                  <h4>{a.data.title}</h4>
                  <span class="news-card-date">{toFa(a.data.publishDate.toLocaleDateString('fa-IR'))}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function(){
  'use strict';

  document.addEventListener('click', function(e){
    var btn = e.target.closest && e.target.closest('[data-hero-hash]');
    if (!btn) return;
    e.preventDefault();
    var visual = btn.closest('.hero-visual');
    if (!visual) return;
    var hash = btn.getAttribute('data-hero-hash') || '';
    var title = btn.getAttribute('data-hero-title') || '';
    if (!hash) return;
    var iframe = document.createElement('iframe');
    iframe.src = 'https://www.aparat.com/video/video/embed/videohash/' + hash + '/vt/frame?autoplay=1';
    iframe.className = 'hero-iframe';
    iframe.title = title;
    iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
    iframe.setAttribute('allowfullscreen','');
    iframe.setAttribute('webkitallowfullscreen','');
    iframe.setAttribute('mozallowfullscreen','');
    iframe.setAttribute('referrerpolicy','strict-origin-when-cross-origin');
    iframe.setAttribute('frameborder','0');
    iframe.setAttribute('scrolling','no');
    visual.querySelectorAll('.hero-thumb, .hero-play, .hero-badge-top, .hero-duration, .hero-link-overlay')
      .forEach(function(n){ n.remove(); });
    visual.appendChild(iframe);
  });

  var track = document.getElementById('reelsTrack');
  var prev = document.getElementById('reelPrev');
  var next = document.getElementById('reelNext');
  var reels = track ? track.querySelectorAll('.reel') : [];
  function step(){
    if (!track || !reels.length) return 200;
    var style = window.getComputedStyle(track);
    var gap = parseFloat(style.gap || style.columnGap) || 12;
    return reels[0].offsetWidth + gap;
  }
  if (track && prev && next){
    next.addEventListener('click', function(){ track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    prev.addEventListener('click', function(){ track.scrollBy({ left: step(), behavior: 'smooth' }); });
  }
  if (track && reels.length){
    var rafId = null;
    var isMobile = function(){ return window.matchMedia('(max-width: 900px)').matches; };
    function updateCenter(){
      rafId = null;
      if (!isMobile()){ reels.forEach(function(r){ r.classList.remove('is-center'); }); return; }
      var rect = track.getBoundingClientRect();
      var cx = rect.left + rect.width / 2;
      var best = null, bestDist = Infinity;
      reels.forEach(function(r){
        var rr = r.getBoundingClientRect();
        var rc = rr.left + rr.width / 2;
        var d = Math.abs(rc - cx);
        if (d < bestDist){ bestDist = d; best = r; }
      });
      reels.forEach(function(r){ r.classList.toggle('is-center', r === best); });
    }
    function schedule(){ if (rafId) return; rafId = requestAnimationFrame(updateCenter); }
    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    updateCenter();
    setTimeout(updateCenter, 200);
    setTimeout(updateCenter, 600);
  }
})();
</script>
