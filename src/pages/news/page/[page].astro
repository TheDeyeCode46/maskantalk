---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';

const normCat = (c) => String(c || '').replace(/[\u200b\u200c\u200d\ufeff]/g, '').trim();

export async function getStaticPaths() {
  const all = await getCollection('articles');
  const articles = all
    .filter(a => {
      const c = normCat(a.data.category);
      return c !== 'ویدیو' && c !== 'کوتاه';
    })
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  const PAGE_SIZE = 12;
  const totalPages = Math.ceil(articles.length / PAGE_SIZE);
  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({ params: { page: String(i) }, props: { pageNum: i } });
  }
  return paths;
}

const { pageNum } = Astro.props;
const all = await getCollection('articles');
const articles = all
  .filter(a => {
    const c = normCat(a.data.category);
    return c !== 'ویدیو' && c !== 'کوتاه';
  })
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const PAGE_SIZE = 12;
const data = articles.slice((pageNum - 1) * PAGE_SIZE, pageNum * PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(articles.length / PAGE_SIZE));
---
<ArchiveLayout title={`اخبار و مقالات — صفحه ${pageNum}`}>
  <div class="archive-grid">
    {data.map(a => (
      <a href={`/articles/${a.id}/`} class="archive-card">
        <div class="ac-thumb">
          {a.data.cover ? <img src={a.data.cover} alt="" loading="lazy" /> : <div class="ph-placeholder full"></div>}
        </div>
        <div class="ac-body">
          <span class="ac-cat">{a.data.category}</span>
          <h3 class="ac-title">{a.data.title}</h3>
          <p class="ac-desc">{a.data.description}</p>
          <div class="ac-meta">
            <span>{a.data.author}</span>
            <span>·</span>
            <span>{a.data.publishDate.toLocaleDateString('fa-IR')}</span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <nav class="pagination">
    <a href={pageNum === 2 ? '/news/' : `/news/page/${pageNum - 1}/`}>قبلی</a>
    {Array.from({ length: lastPage }, (_, i) => i + 1).map(n => (
      n === pageNum
        ? <span class="current">{n}</span>
        : <a href={n === 1 ? '/news/' : `/news/page/${n}/`}>{n}</a>
    ))}
    {pageNum < lastPage
      ? <a href={`/news/page/${pageNum + 1}/`}>بعدی</a>
      : <span class="disabled">بعدی</span>}
  </nav>
</ArchiveLayout>