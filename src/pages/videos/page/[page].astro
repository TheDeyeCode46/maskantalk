---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';

const normCat = (c) => String(c || '').replace(/[\u200b\u200c\u200d\ufeff]/g, '').trim();

export async function getStaticPaths() {
  const all = await getCollection('articles');
  const videos = all
    .filter(a => normCat(a.data.category) === 'ویدیو')
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  const PAGE_SIZE = 12;
  const totalPages = Math.ceil(videos.length / PAGE_SIZE);
  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({ params: { page: String(i) }, props: { pageNum: i } });
  }
  return paths;
}

const { pageNum } = Astro.props;
const all = await getCollection('articles');
const videos = all
  .filter(a => normCat(a.data.category) === 'ویدیو')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const PAGE_SIZE = 12;
const data = videos.slice((pageNum - 1) * PAGE_SIZE, pageNum * PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(videos.length / PAGE_SIZE));
---
<ArchiveLayout title={`قسمت‌های مسکن‌تاک — صفحه ${pageNum}`}>
  <div class="archive-grid">
    {data.map(v => (
      <a href={`/articles/${v.id}/`} class="archive-card">
        <div class="ac-thumb">
          {v.data.cover ? <img src={v.data.cover} alt="" loading="lazy" /> : <div class="ph-placeholder full"></div>}
          <span class="ac-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
        </div>
        <div class="ac-body">
          <span class="ac-cat">{v.data.tags[0] ?? 'برنامه'}</span>
          <h3 class="ac-title">{v.data.title}</h3>
          <p class="ac-desc">{v.data.description}</p>
          <div class="ac-meta">
            <span>{v.data.author}</span>
            <span>·</span>
            <span>{v.data.publishDate.toLocaleDateString('fa-IR')}</span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <nav class="pagination">
    <a href={pageNum === 2 ? '/videos/' : `/videos/page/${pageNum - 1}/`}>قبلی</a>
    {Array.from({ length: lastPage }, (_, i) => i + 1).map(n => (
      n === pageNum
        ? <span class="current">{n}</span>
        : <a href={n === 1 ? '/videos/' : `/videos/page/${n}/`}>{n}</a>
    ))}
    {pageNum < lastPage
      ? <a href={`/videos/page/${pageNum + 1}/`}>بعدی</a>
      : <span class="disabled">بعدی</span>}
  </nav>
</ArchiveLayout>