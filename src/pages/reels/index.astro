---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';

const all = await getCollection('articles');
const reels = all
  .filter(a => a.data.category === 'کوتاه')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const pageSize = 16;
const data = reels.slice(0, pageSize);
const lastPage = Math.max(1, Math.ceil(reels.length / pageSize));
---
<ArchiveLayout
  title="برش‌های کوتاه"
  description="ویدیوهای کوتاه و ریلز مسکن‌تاک"
  intro="کلیپ‌های کوتاه، برش‌های برنامه و ریلزهای اینستاگرام و آپارات."
>
  {data.length === 0 ? (
    <div class="empty-state">هنوز کلیپ کوتاهی منتشر نشده.</div>
  ) : (
    <div class="reels-grid">
      {data.map(r => (
        <a href={`/articles/${r.id}/`} class="reel-archive-card">
          {r.data.cover && <img src={r.data.cover} alt="" />}
          <div class="body">
            <h4>{r.data.title}</h4>
            <span>{r.data.duration ?? ''}</span>
          </div>
        </a>
      ))}
    </div>
  )}

  <nav class="pagination">
    <span class="disabled">قبلی</span>
    {Array.from({ length: lastPage }, (_, i) => i + 1).map(n => (
      n === 1 ? <span class="current">1</span> : <a href={`/reels/page/${n}/`}>{n}</a>
    ))}
    {lastPage > 1 ? <a href="/reels/page/2/">بعدی</a> : <span class="disabled">بعدی</span>}
  </nav>
</ArchiveLayout>