---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { extractAparatHash } from '../../lib/aparat';
import { normCat } from '../../lib/categories';

const all = await getCollection('articles');
const reels = all
  .filter(a => normCat(a.data.category) === 'کوتاه')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const PAGE_SIZE = 20;
const data = reels.slice(0, PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(reels.length / PAGE_SIZE));
---
<ArchiveLayout
  title="برش‌های کوتاه"
  description="ویدیوهای کوتاه و ریلز مسکن‌تاک"
  intro="کلیپ‌های کوتاه مسکن‌تاک — روی هر کارت بزنید تا پخش شود."
>
  {data.length === 0 ? (
    <div class="empty-state">هنوز کلیپ کوتاهی منتشر نشده.</div>
  ) : (
    <div class="reels-grid">
      {data.map(r => {
        const hash = r.data.aparatHash ? extractAparatHash(r.data.aparatHash) : null;
        return (
          <button
            type="button"
            class="reel-tile"
            data-video-open
            data-file={r.data.videoFile ?? ''}
            data-url={r.data.videoUrl ?? ''}
            data-hash={hash ?? ''}
            data-title={r.data.title}
            data-article={r.id}
            data-instagram={r.data.instagramUrl ?? ''}
            aria-label={r.data.title}
          >
            {r.data.cover ? <img src={r.data.cover} alt="" loading="lazy" /> : <div class="ph-placeholder full"></div>}
            <span class="reel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M17 10.5V6.5c0-.83-.67-1.5-1.5-1.5h-11C3.67 5 3 5.67 3 6.5v11c0 .83.67 1.5 1.5 1.5h11c.83 0 1.5-.67 1.5-1.5v-4l5 4v-11l-5 4z"/></svg>
            </span>
          </button>
        );
      })}
    </div>
  )}

  {lastPage > 1 && (
    <nav class="pagination">
      <span class="disabled">قبلی</span>
      {Array.from({ length: lastPage }, (_, i) => i + 1).map(n => (
        n === 1 ? <span class="current">{n}</span> : <a href={`/reels/page/${n}/`}>{n}</a>
      ))}
      {lastPage > 1 ? <a href="/reels/page/2/">بعدی</a> : <span class="disabled">بعدی</span>}
    </nav>
  )}
</ArchiveLayout>
