---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import { extractAparatHash } from '../../../lib/aparat';
import { normCat } from '../../../lib/categories';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  const reels = all
    .filter(a => normCat(a.data.category) === 'کوتاه')
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  const PAGE_SIZE = 20;
  const totalPages = Math.ceil(reels.length / PAGE_SIZE);
  const paths = [];
  for (let i = 2; i <= totalPages; i++) {
    paths.push({ params: { page: String(i) }, props: { pageNum: i } });
  }
  return paths;
}

const { pageNum } = Astro.props;
const all = await getCollection('articles');
const reels = all
  .filter(a => normCat(a.data.category) === 'کوتاه')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const PAGE_SIZE = 20;
const data = reels.slice((pageNum - 1) * PAGE_SIZE, pageNum * PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(reels.length / PAGE_SIZE));
---
<ArchiveLayout title={`برش‌های کوتاه — صفحه ${pageNum}`}>
  <div class="reels-grid">
    {data.map(r => {
      const hash = r.data.aparatHash ? extractAparatHash(r.data.aparatHash) : null;
      return (
        <button
          type="button"
          class="reel-tile"
          data-video-open
          data-file={r.data.videoFile ?? ''}
          data-url={r.data.videoUrl ?? ''}
          data-hash={hash ?? ''}
          data-title={r.data.title}
          data-article={r.id}
          data-instagram={r.data.instagramUrl ?? ''}
          aria-label={r.data.title}
        >
          {r.data.cover ? <img src={r.data.cover} alt="" loading="lazy" /> : <div class="ph-placeholder full"></div>}
          <span class="reel-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span>
          <div class="body">
            <h4>{r.data.title}</h4>
            <span>{r.data.duration ?? ''}</span>
          </div>
        </button>
      );
    })}
  </div>

  <nav class="pagination">
    <a href={pageNum === 2 ? '/reels/' : `/reels/page/${pageNum - 1}/`}>قبلی</a>
    {Array.from({ length: lastPage }, (_, i) => i + 1).map(n => (
      n === pageNum
        ? <span class="current">{n}</span>
        : <a href={n === 1 ? '/reels/' : `/reels/page/${n}/`}>{n}</a>
    ))}
    {pageNum < lastPage
      ? <a href={`/reels/page/${pageNum + 1}/`}>بعدی</a>
      : <span class="disabled">بعدی</span>}
  </nav>
</ArchiveLayout>
