---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  const reels = all
    .filter(a => a.data.category === 'کوتاه')
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  const pageSize = 16;
  const totalPages = Math.ceil(reels.length / pageSize);
  const paths = [];
  for (let i = 1; i < totalPages; i++) {
    paths.push({ params: { page: String(i + 1) }, props: { pageNum: i + 1 } });
  }
  return paths;
}

const { pageNum } = Astro.props;
const all = await getCollection('articles');
const reels = all
  .filter(a => a.data.category === 'کوتاه')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const pageSize = 16;
const data = reels.slice((pageNum - 1) * pageSize, pageNum * pageSize);
const lastPage = Math.max(1, Math.ceil(reels.length / pageSize));
---
<ArchiveLayout title={`برش‌های کوتاه — صفحه ${pageNum}`}>
  <div class="reels-grid">
    {data.map(r => (
      <a href={`/articles/${r.id}/`} class="reel-archive-card">
        {r.data.cover && <img src={r.data.cover} alt="" />}
        <div class="body">
          <h4>{r.data.title}</h4>
          <span>{r.data.duration ?? ''}</span>
        </div>
      </a>
    ))}
  </div>

  <nav class="pagination">
    <a href={pageNum === 2 ? '/reels/' : `/reels/page/${pageNum - 1}/`}>قبلی</a>
    {Array.from({ length: lastPage }, (_, i) => i + 1).map(n => (
      n === pageNum ? <span class="current">{n}</span> : <a href={n === 1 ? '/reels/' : `/reels/page/${n}/`}>{n}</a>
    ))}
    {pageNum < lastPage ? <a href={`/reels/page/${pageNum + 1}/`}>بعدی</a> : <span class="disabled">بعدی</span>}
  </nav>
</ArchiveLayout>