---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';

export async function getStaticPaths({ paginate }) {
  const all = await getCollection('articles');
  const articles = all
    .filter(a => !['ویدیو', 'کوتاه'].includes(a.data.category))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  return paginate(articles, { pageSize: 12 });
}

const { page } = Astro.props;
---
<ArchiveLayout
  title="اخبار و مقالات"
  description="آرشیو اخبار، تحلیل‌ها و یادداشت‌های مسکن‌تاک"
  intro="همه اخبار، تحلیل‌ها، یادداشت‌ها و گزارش‌های داده مسکن‌تاک."
>
  {page.data.length === 0 ? (
    <div class="empty-state">هنوز مقاله‌ای منتشر نشده.</div>
  ) : (
    <div class="archive-grid-3">
      {page.data.map(a => (
        <a href={`/articles/${a.id}/`} class="archive-card">
          <div class="ac-thumb">
            {a.data.cover && <img src={a.data.cover} alt="" />}
          </div>
          <div class="ac-body">
            <span class="ac-cat">{a.data.category}</span>
            <h3 class="ac-title">{a.data.title}</h3>
            <p class="ac-desc">{a.data.description}</p>
            <div class="ac-meta">
              <span>{a.data.author}</span>
              <span>·</span>
              <span>{a.data.publishDate.toLocaleDateString('fa-IR')}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  )}

  <nav class="pagination">
    {page.url.prev ? <a href={page.url.prev}>قبلی</a> : <span class="disabled">قبلی</span>}
    {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(n => (
      n === page.currentPage ? <span class="current">{n}</span> : <a href={n === 1 ? '/articles/' : `/articles/${n}/`}>{n}</a>
    ))}
    {page.url.next ? <a href={page.url.next}>بعدی</a> : <span class="disabled">بعدی</span>}
  </nav>
</ArchiveLayout>