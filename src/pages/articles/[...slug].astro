---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AparatEmbed from '../../components/AparatEmbed.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const VIDEO_CATS = ['ویدیو', 'کوتاه'];
const isVideo = VIDEO_CATS.includes(article.data.category);

const allArticles = await getCollection('articles');

// Recommender: shared tags first, then same category
const related = allArticles
  .filter(a => a.id !== article.id)
  .map(a => {
    const sharedTags = a.data.tags.filter(t => article.data.tags.includes(t)).length;
    const sameCat = a.data.category === article.data.category ? 1 : 0;
    return { article: a, score: sharedTags * 2 + sameCat };
  })
  .filter(x => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(x => x.article);
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="single">
    <div class="single-head">
      <span class="single-cat">{article.data.category}</span>
      <h1>{article.data.title}</h1>
      <p class="single-desc">{article.data.description}</p>
      <div class="single-meta">
        <span>{article.data.author}</span>
        <span>·</span>
        <span>{article.data.publishDate.toLocaleDateString('fa-IR')}</span>
        {article.data.duration && <>
          <span>·</span>
          <span>{article.data.duration}</span>
        </>}
      </div>
    </div>

    {article.data.aparatHash && (
      <AparatEmbed
        hash={article.data.aparatHash}
        title={article.data.title}
        aspect={article.data.category === 'کوتاه' ? '9:16' : '16:9'}
      />
    )}

    {article.data.instagramUrl && (
      <div class="instagram-link">
        <a href={article.data.instagramUrl} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4 1.3-.1 1.7-.1 4.8-.1zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm6.2-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0z"/></svg>
          مشاهده در اینستاگرام
        </a>
      </div>
    )}

    {!article.data.aparatHash && article.data.cover && (
      <div class="single-cover">
        <img src={article.data.cover} alt={article.data.title} />
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    {related.length > 0 && (
      <section class="related">
        <h3>مطالب مرتبط</h3>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/articles/${r.id}/`} class="related-card">
              {r.data.cover && <img src={r.data.cover} alt="" class="related-thumb" />}
              <span class="related-cat">{r.data.category}</span>
              <h4>{r.data.title}</h4>
              <p>{r.data.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .single { max-width: 780px; margin: 0 auto; padding: 3rem 1.25rem 5rem; }
  .single-head { margin-bottom: 2rem; }
  .single-cat {
    display: inline-block; color: #F5A623; font-size: 0.72rem; font-weight: 800;
    letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 0.8rem;
  }
  .single-head h1 {
    font-size: clamp(1.5rem, 4vw, 2.4rem); font-weight: 900; line-height: 1.35;
    letter-spacing: -0.02em; margin-bottom: 1rem; color: #fff;
  }
  .single-desc { font-size: 1rem; line-height: 1.9; color: #A8ACBE; margin-bottom: 1rem; }
  .single-meta {
    display: flex; align-items: center; gap: 0.5rem; color: #6E7288;
    font-size: 0.82rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.07);
  }
  .single-cover { margin: 1.5rem 0; border-radius: 16px; overflow: hidden; }
  .single-cover img { width: 100%; display: block; }
  .instagram-link { margin: 1rem 0; }
  .instagram-link a {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: #E84C3D; font-weight: 700; font-size: 0.85rem;
    padding: 0.6rem 1rem; border: 1px solid rgba(232,76,61,0.3);
    border-radius: 12px; background: rgba(232,76,61,0.08);
  }
  .prose { font-size: 1rem; line-height: 2; color: rgba(255,255,255,0.9); }
  .prose :global(h2) { font-size: 1.4rem; font-weight: 800; margin: 2.5rem 0 1rem; color: #fff; }
  .prose :global(h3) { font-size: 1.15rem; font-weight: 700; margin: 2rem 0 0.75rem; color: #fff; }
  .prose :global(p) { margin-bottom: 1.25rem; }
  .prose :global(ul), .prose :global(ol) { padding-right: 1.5rem; margin-bottom: 1.25rem; }
  .prose :global(li) { margin-bottom: 0.5rem; }
  .prose :global(a) { color: #F5A623; text-decoration: underline; }
  .prose :global(blockquote) {
    border-right: 3px solid #F5A623; padding-right: 1rem; margin: 1.5rem 0;
    font-style: italic; color: #A8ACBE;
  }
  .prose :global(img) { border-radius: 12px; margin: 1.5rem 0; }

  .related { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.07); }
  .related h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 1.25rem; color: #fff; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .related-card {
    background: #16171F; border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px; padding: 1rem; transition: all 0.3s; display: block;
  }
  .related-card:hover { border-color: rgba(245,166,35,0.35); transform: translateY(-3px); }
  .related-thumb { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 10px; margin-bottom: 0.6rem; }
  .related-cat { display: inline-block; color: #F5A623; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.1em; margin-bottom: 0.4rem; }
  .related-card h4 { font-size: 0.92rem; font-weight: 700; line-height: 1.5; color: #fff; margin-bottom: 0.5rem; }
  .related-card p { font-size: 0.78rem; line-height: 1.6; color: #A8ACBE; }
</style>