---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AparatEmbed from '../../components/AparatEmbed.astro';
import { extractAparatHash } from '../../lib/aparat';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const normCat = (c) => String(c || '').replace(/[\u200b\u200c\u200d\ufeff]/g, '').trim();
const cat = normCat(article.data.category);
const isReel = cat === 'کوتاه';
const isVideo = cat === 'ویدیو';
const aspect = isReel ? '9:16' : '16:9';

const allArticles = await getCollection('articles');
const related = allArticles
  .filter(a => a.id !== article.id)
  .map(a => {
    const shared = a.data.tags.filter(t => article.data.tags.includes(t)).length;
    const sameCat = normCat(a.data.category) === cat ? 1 : 0;
    return { article: a, score: shared * 2 + sameCat };
  })
  .filter(x => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(x => x.article);

const aparatHash = article.data.aparatHash ? extractAparatHash(article.data.aparatHash) : null;
---
<BaseLayout title={article.data.title} description={article.data.description}>
  <section class="page-light">
    <div class="container">
      <article class="single">
        <div class="single-head">
          <span class="single-cat">{article.data.category}</span>
          <h1>{article.data.title}</h1>
          <div class="single-meta">
            <span>{article.data.author}</span>
            <span>·</span>
            <span>{article.data.publishDate.toLocaleDateString('fa-IR')}</span>
            {article.data.duration && <><span>·</span><span>{article.data.duration}</span></>}
            {article.data.episode && <><span>·</span><span>قسمت {article.data.episode}</span></>}
          </div>
        </div>

        {aparatHash && (
          <AparatEmbed
            hash={article.data.aparatHash!}
            title={article.data.title}
            aspect={aspect}
            autoplay={false}
          />
        )}

        {!aparatHash && article.data.cover && (
          <div class="single-cover">
            <img src={article.data.cover} alt={article.data.title} />
          </div>
        )}

        {article.data.instagramUrl && (
          <div style="margin:1rem 0 1.5rem;">
            <a
              href={article.data.instagramUrl}
              target="_blank"
              rel="noopener"
              style="display:inline-flex;align-items:center;gap:.5rem;color:#E84C3D;font-weight:700;font-size:.85rem;padding:.6rem 1rem;border:1px solid rgba(232,76,61,.3);border-radius:12px;background:rgba(232,76,61,.08);"
            >
              مشاهده در اینستاگرام ↗
            </a>
          </div>
        )}

        <div class="prose">
          <Content />
        </div>

        {related.length > 0 && (
          <section class="related">
            <h3>مطالب مرتبط</h3>
            <div class="related-grid">
              {related.map(r => (
                <a href={`/articles/${r.id}/`} class="related-card">
                  {r.data.cover && (
                    <img src={r.data.cover} alt="" class="related-thumb" loading="lazy" />
                  )}
                  <div class="related-body">
                    <span class="related-cat">{r.data.category}</span>
                    <h4>{r.data.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    </div>
  </section>
</BaseLayout>