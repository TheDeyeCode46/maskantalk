---
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<title>تست محتوا</title>
</head>
<body style="font-family: Tahoma; padding: 2rem; direction: rtl;">
  <h1>تعداد مقالات: {articles.length}</h1>
  {articles.map(article => (
    <div style="border: 1px solid #ccc; padding: 1rem; margin: 1rem 0;">
      <h2>{article.data.title}</h2>
      <p>{article.data.description}</p>
      <p>دسته: {article.data.category}</p>
      <p>تاریخ: {article.data.publishDate.toLocaleDateString('fa-IR')}</p>
    </div>
  ))}
</body>
</html>